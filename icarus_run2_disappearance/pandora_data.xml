<?xml version="1.0" ?>

<!--specifies neutrino mode or antineutrino mode-->
<mode name="nu" />

<detector name="ICARUS" />

<channel name="numu" unit="Reconstructed Neutrino Energy [GeV]">
    <bins edges="0.3 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1.0 1.25 1.5 2.0 2.5"/>
    <truebins min="0" max="3" nbins="150"/>
    <otherbins unit="True E [GeV]" min="0.3" max="3" nbins="20"/>
    <otherbins unit="Reconstructed Muon Momentum [GeV]" min="0.2" max="1.6" nbins="20"/>
    <otherbins unit="Reconstructed Leading Proton Momentum [GeV]" min="0.3" max="1.3" nbins="20"/>
    <otherbins unit="#deltap^{T}" min="0" max="1.2" nbins="20"/>
    <otherbins unit="Muon #chi^{2}_{#mu}" min="0" max="30" nbins="30"/>
    <otherbins unit="Leading Proton #chi^{2}_{p}" min="0" max="100" nbins="40"/>

    <subchannel name="data" plotname="Data" color="#FBBC04"/>
</channel>

<!--<plotpot value="2.0e20"/>-->
<plotpot value="1.596e20"/>

<MCFile treename="events/selected_events" filename="pandora_data.root" scale = "1.0" pot="1.596e20"> 
    <branch
        associated_subchannel = "nu_ICARUS_numu_data"
        name                  = "recoE"
        true_param_name       = "0" 
        model_rule            = "0"
        true_L_name           = "0"
        other_param_names     = "0;reco_muon_p;leading_proton_p;deltaPt;chi2_mu;chi2_p"
        pdg_name              = "0"
        additional_weight     = "Run != 9435"
    />
</MCFile>
