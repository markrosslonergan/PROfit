    <allowlist type="covariance" plotname="FSI_pi" tag="xsecsyst">GENIEReWeight_SBN_v1_multisim_FSI_pi_VariationResponse</allowlist>
    <allowlist type="covariance" plotname="FSI_N" tag="xsecsyst">GENIEReWeight_SBN_v1_multisim_FSI_N_VariationResponse</allowlist>
    <allowlist type="spline"  binning="other0" plotname="RPA_CCQE" tag="xsecsyst">GENIEReWeight_SBN_v1_multisigma_RPA_CCQE</allowlist>
    <allowlist type="spline"  binning="other0" plotname="CoulombCCQE" tag="xsecsyst">GENIEReWeight_SBN_v1_multisigma_CoulombCCQE</allowlist>
    <allowlist type="spline"  binning="other0" plotname="NormCCMEC" tag="xsecsyst">GENIEReWeight_SBN_v1_multisigma_NormCCMEC</allowlist>
    <allowlist type="covariance" plotname="NormNCMEC" tag="xsecsyst">GENIEReWeight_SBN_v1_multisim_NormNCMEC</allowlist>
    <allowlist type="covariance" plotname="NonRESBGvpCC1pi" tag="xsecsyst">GENIEReWeight_SBN_v1_multisim_NonRESBGvpCC1pi</allowlist>
    <allowlist type="covariance" plotname="NonRESBGvpCC2pi" tag="xsecsyst">GENIEReWeight_SBN_v1_multisim_NonRESBGvpCC2pi</allowlist>
    <allowlist type="covariance" plotname="NonRESBGvpNC1pi" tag="xsecsyst">GENIEReWeight_SBN_v1_multisim_NonRESBGvpNC1pi</allowlist>
