<?xml version="1.0" ?>

<!--specifies neutrino mode or antineutrino mode-->
<mode name="nu" />

<detector name="ICARUS" />

<channel name="numu" unit="Reconstructed Neutrino Energy [GeV]">
    <bins edges="0.3 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1.0 1.25 1.5 2.0 2.5"/>
    <truebins min="0" max="3" nbins="150"/>
    <otherbins unit="True E [GeV]" min="0.3" max="3" nbins="20"/>
    <subchannel name="intime" plotname="Intime Cosmics" color="#FBBC04"/>
    <subchannel name="cos" plotname="Cosmics" color="#E37400"/>
    <subchannel name="nc" plotname="NC" color="#FF6961"/>
    <subchannel name="nuecc" plotname="#nu_{e} CC" color="#34A853"/>
    <subchannel name="numucc" plotname="#nu_{#mu} CC" color="#99CCFF"/>

</channel>

<plotpot value="1.596e20"/>

<variation_list>
    <!-- MC Statistics -->
    <allowlist type="mcstat" plotname="MC Stats" tag="stat"></allowlist>
    
    <!-- Interaction Model Systematics -->
