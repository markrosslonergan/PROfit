    <allowlist type="spline" binning="other0" plotname="ZExp_b3" tag="xsecsyst">ZExpPCAWeighter_SBNNuSyst_ZExpPCA_multisigma_b3</allowlist>
    <allowlist type="spline" binning="other0" plotname="ZExp_b4" tag="xsecsyst">ZExpPCAWeighter_SBNNuSyst_ZExpPCA_multisigma_b4</allowlist>
    <allowlist type="covariance" plotname="NCELVariationResponse" tag="xsecsyst">GENIEReWeight_SBN_v1_multisim_NCELVariationResponse</allowlist>
    <allowlist type="spline" binning="other0" plotname="MaCCRES" tag="xsecsyst">GENIEReWeight_SBN_v1_multisigma_MaCCRES</allowlist>
    <allowlist type="spline"  binning="other0" plotname="MvCCRES" tag="xsecsyst">GENIEReWeight_SBN_v1_multisigma_MvCCRES</allowlist>
    <allowlist type="covariance" plotname="NCRESVariationResponse" tag="xsecsyst">GENIEReWeight_SBN_v1_multisim_NCRESVariationResponse</allowlist>
