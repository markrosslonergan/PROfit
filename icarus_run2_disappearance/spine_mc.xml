    <allowlist type="spline"  binning="other0" plotname="DecayAngMEC" tag="xsecsyst">GENIEReWeight_SBN_v1_multisigma_DecayAngMEC</allowlist>
    <allowlist type="spline"  binning="other0" plotname="XSecShape_CCMEC" tag="xsecsyst">GENIEReWeight_SBNNuSyst_GENIE_multisigma_XSecShape_CCMEC</allowlist>
