    <!--- Detector and Reconstruction Systematics -->
    <allowlist type="spline" binning="reco" plotname="8msLifetime" tag="detsyst">var01</allowlist>
    <allowlist type="spline" binning="reco" plotname="Ind1WireGap" tag="detsyst">var04</allowlist>
    <allowlist type="spline" binning="reco" plotname="Ind2ShapingTime" tag="detsyst">var11</allowlist>
    <allowlist type="spline" binning="reco" plotname="Recomb" tag="detsyst">var05</allowlist>
    <allowlist type="spline" binning="reco" plotname="PMTQE" tag="detsyst">var06</allowlist>
    <allowlist type="spline" binning="reco" plotname="CohNoise" tag="detsyst">var10</allowlist>
    <allowlist type="spline" binning="reco" plotname="IntNoise" tag="detsyst">var13</allowlist>
    <allowlist type="spline" binning="reco" plotname="TPCYZNonUni" tag="detsyst">var07</allowlist>
    <allowlist type="spline" binning="reco" plotname="SignalShape" tag="detsyst">var12</allowlist>

    <!-- Unused Detector and Reconstruction Systematics -->
    <!--<allowlist type="spline" binning="reco" plotname="OldIntrinsicNoise" tag="det">var09</allowlist>-->
    <!--<allowlist type="spline" binning="reco" plotname="FrontInductionGain" tag="det">var03</allowlist>-->

    <!--- Normalization Systematics -->
    <allowlist type="norm" binning="reco" plotname="FluxNorm">nu_ICARUS_numu_n:0.02</allowlist>
    <allowlist type="norm" plotname="FiducialVol">nu_ICARUS:0.01</allowlist>
</variation_list>

<model tag="numudis">
    <rule index="0" name="No Osc"/>
    <rule index="1" name="Numu Dis"/>
</model>

<MCFile treename="events/full/selected" filename="spine_mc.root" scale = "1.0" pot="1.67528e21"> 
    <friend treename="events/full/multisigmaTree" />
    <friend treename="events/full/multisimTree" />
    <friend treename="events/full/variationTree" />
    <branch
        associated_subchannel = "nu_ICARUS_numu_numucc"
        name                  = "reco_visible_energy"
        true_param_name       = "true_neutrino_energy" 
        model_rule            = "1"
        true_L_name           = "true_baseline / 1000"
        pdg_name              = "true_pdg"
        additional_weight     = "true_cc && (true_pdg == 14 || true_pdg == -14) && true_neutrino_id >= 0"
        other_param_names     = "true_neutrino_energy"
        />
    <branch
        associated_subchannel = "nu_ICARUS_numu_nuecc"
        name                  = "reco_visible_energy"
        true_param_name       = "true_neutrino_energy" 
        model_rule            = "0"
        true_L_name           = "true_baseline / 1000"
        pdg_name              = "true_pdg"
        additional_weight     = "true_cc && (true_pdg == 12 || true_pdg == -12) && true_neutrino_id >= 0"
        other_param_names     = "true_neutrino_energy"
        />
    <branch
        associated_subchannel = "nu_ICARUS_numu_nc"
        name                  = "reco_visible_energy"
        true_param_name       = "true_neutrino_energy" 
        model_rule            = "1"
        true_L_name           = "true_baseline / 1000"
        pdg_name              = "true_pdg"
        additional_weight     = "true_cc == 0 && true_neutrino_id >= 0"
        other_param_names     = "true_neutrino_energy"
        />
    <branch
        associated_subchannel = "nu_ICARUS_numu_cos"
        name                  = "reco_visible_energy"
        incl_systematics      = "false"
        model_rule            = "0"
        true_param_name       = "0"
        true_L_name           = "0"
        pdg_name              = "0"
        additional_weight     = "true_neutrino_id < 0"
        other_param_names     = "0"
        />
</MCFile>
<MCFile treename="events/offbeam/selected" filename="spine_mc.root" scale = "1.0" pot="1.596e20"> 
    <branch
        associated_subchannel = "nu_ICARUS_numu_intime"
        name                  = "reco_visible_energy"
        incl_systematics      = "false"
        model_rule            = "0"
        true_param_name       = "0"
        true_L_name           = "0"
        pdg_name              = "0"
        other_param_names     = "0"
        />
</MCFile>
