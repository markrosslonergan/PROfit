<?xml version="1.0" ?>

<!-- One Mode -->
<mode name="nu" />

<!-- Two Detector SBN Snalysis-->
<detector name="SBND" pot="9.7e20"/>
<detector name="ICARUS" pot="13.1e20"/>

<!-- Two Channels, numu and nue selections -->
<channel name="numu" plotname="#nu_{#mu} Selection">
    <bins unit = "Reconstructed Neutrino Energy [GeV]" min="0.2" max="3" nbins="28" />
    <bins unit = "True L/E" min="0" max="3" nbins="250" plot="false"/>
    <subchannel name="numucc" plotname="#nu_{#mu} CC" color="#99CCFF"/>
</channel>
<channel name="nue" plotname="#nu_{e} Selection">
    <bins unit = "Reconstructed Neutrino Energy [GeV]" min="0.2" max="3" nbins="14"  />
    <bins unit = "True L/E" min="0" max="3" nbins="250" plot="false"/>
    <subchannel name="intrinsic" plotname="#nu_{e} CC"                    color="#33CC33"/>
    <subchannel name="fullosc"   plotname="#nu_{#mu} #rightarrow #nu_{e}" color="#FFFF99"/>
</channel>

<!-- The Physics model, here nue-appearance only -->
<model tag="nueapp">
    <rule index="0" name="No Osc"/>
    <rule index="1" name="Nue App"/>
    <parameter variable_index = "1" name="L/E"/>
</model>

<!-- Where to find the Montecarlo and how to fill all the subchannels defined above-->
<MCFile treename="events/selectedNu" filename="/exp/sbnd/data/users/markross/PROfit_Data/Tutorial2025/sbnd_bnbcv_sBrucetree_197.root" scale = "1.0" pot="2.15692e19">
    <friend treename="events/multisigmaTree" />
    <friend treename="events/multisimTree" />
    <branch
        associated_subchannel = "nu_SBND_numu_numucc"
        model_rule            = "0"
        additional_weight     = "0.9*CC*(truePDG == 14 || truePDG == -14)*(recoE>0)"
        >
        <variable>recoE</variable>
        <variable>trueL/(trueE*1000.0)</variable>
    </branch>
</MCFile>

<MCFile treename="events/selectedNu" filename="/exp/sbnd/data/users/markross/PROfit_Data/Tutorial2025/icarus_bnbcv_sBrucetree_10.root" scale = "1.0" pot="1.60787e20">
    <friend treename="events/multisigmaTree" />
    <friend treename="events/multisimTree" />
    <branch
        associated_subchannel = "nu_ICARUS_numu_numucc"
        model_rule            = "0"
        additional_weight     = "0.9*CC*(truePDG == 14 || truePDG == -14)*(recoE>0)"
        >
        <variable>recoE</variable>
        <variable>trueL/(trueE*1000.0)</variable>
